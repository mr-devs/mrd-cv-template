% HOW TO USE WITH THIS CV FORMAT
% -----------------------------
% 1. Mark items with a "keyword" that specifies the type of item they will be grouped by within the CV
% 2. Call \printbibliography in main.tex with the class ('article', 'misc', etc.) and keyword to "select" only the items you want for that group of items
% 3. Leave the trailing period off titles; each part of an entry prints on its own line
% 4. Put the DOI (https://doi.org/...) or another link in `url`; it becomes the link on the title
% 5. Add `month` wherever you know it; it is never printed but orders same-year entries


% Journals
% Give articles a `month` so same-year entries sort correctly.
% Only the year is printed.
% #########################################################
@article{art1,
    author={\textbf{Smith, John R.} and Brown, Michael and Yang, Steven},
    title = {{Paper Title Goes Here}},
    journal = {Journal Title},
    volume = {1},
    number = {1},
    month = mar,
    year = {2023},
    url = {https://example.com},
    keywords={J},
    addendum = {\\ -- Add \textit{Extra Accolades} about \href{https://www.nature.com/Coolections/jhjibhhicg}{Your Article} \\ -- Write text here as normal LateX Allowing \href{https://example.com}{Special Formatting} \\ -- Best Paper Award (Conference XXX 2021)}
}

% Include daggers like below to mark equal contribution!
@article{art2,
    author={\textbf{Guy$^{\dagger}$, Smart} and Gal$^{\dagger}$, Smart},
    title = {{Paper Title Goes Here}},
    journal = {Journal Title},
    volume = {1},
    number = {1},
    month = sep,
    year = {2023},
    url = {https://example.com},
    keywords={J}
}

% A third entry makes the reverse numbering (3, 2, 1) visible in the output.
@article{art3,
    author={\textbf{Smith, John R.} and Coauthor, Ada and Yang, Steven},
    title = {{Newest Paper Title Goes Here}},
    journal = {Another Journal Title},
    volume = {2},
    number = {4},
    pages = {101--120},
    month = feb,
    year = {2024},
    url = {https://example.com},
    keywords={J}
}


